  "secrets": [],
  "tests": [
    {
      "id": "rss.main-list",
      "name": "Item list renders",
      "path": "/",
      "expectSelector": "#item-list",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "styles/tailwind-input.css"
      ]
    },
    {
      "id": "rss.mark-all-read",
      "name": "Header menu actions",
      "path": "/?demo=1",
      "expectSelector": "#header-menu-btn",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "id": "rss.header-status",
      "name": "Header status line renders next to title",
      "path": "/?demo=1",
      "expectSelector": "#header-status",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "id": "rss.item-thumbnails",
      "name": "Item thumbnails render",
      "path": "/?demo=1",
      "expectSelector": "#item-list img",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "id": "rss.item-saved-badge",
      "name": "Saved badge renders on bookmarked card",
      "path": "/?demo=1",
      "expectSelector": "#item-list .item-saved",
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "id": "rss.item-thumb-fallback",
      "name": "Item thumbnail fallback dot renders",
      "path": "/?demo=1",
      "expectSelector": "#item-list .item-feed-dot",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "id": "rss.feeds-screen",
      "name": "Feeds screen renders",
      "path": "/?view=feeds",
      "expectSelector": "#feed-list",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "id": "rss.article-view",
      "name": "Article preview renders",
      "path": "/?demo=article",
      "expectSelector": "#article-view",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "id": "rss.filter-chips",
      "name": "Filter dropdown renders with Unread default",
      "path": "/?view=unread&demo=1",
      "expectSelector": "#header-status",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "id": "rss.theme.light-default",
      "name": "Solarized light when the platform theme is light",
      "path": "/?demo=1",
      "expectSelector": "html[data-theme='light']",
      "impact": [
        "public/index.html",
        "styles/tailwind-input.css",
        "server.js"
      ]
    },
    {
      "id": "rss.theme.dark-override",
      "name": "Solarized dark when the platform theme is dark",
      "path": "/?demo=1&theme=dark",
      "expectSelector": "html[data-theme='dark']",
      "impact": [
        "public/index.html",
        "styles/tailwind-input.css",
        "server.js"
      ]
    }
  ]
